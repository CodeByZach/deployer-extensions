{
    "name": "codebyzach/deployer-extensions",
    "description": "Custom Deployer recipes and tasks",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/CodeByZach/deployer-extensions",
    "authors": [
        {
            "name": "Zachary Miller",
            "email": "codebyzach@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "CodeByZach\\DeployerExtensions\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
        "check": "php-cs-fixer check",
        "fix": "php-cs-fixer fix",
        "smoke": "dep -f tests/Support/smoke.php smoke local"
    },
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "deployer/deployer": "^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "^5.1",
        "phpstan/phpstan": "^2.2",
        "symfony/console": "^7.4.0 || ^8.0.0",
        "symfony/process": "^7.4.0 || ^8.0.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
